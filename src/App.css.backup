@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap');

:root {
  font-family: 'DM Sans', sans-serif;
  color: #292730;
  background: #f8f7f5;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  font-optical-sizing: auto;
  font-weight: 400;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-width: 360px;
  min-height: 100vh;
}

button, input, textarea, select {
  font: inherit;
}

button {
  cursor: pointer;
}

button:focus-visible, input:focus-visible, textarea:focus-visible,
select:focus-visible {
  outline: 2px solid #9181bb;
  outline-offset: 3px;
}

.app-shell {
  display: flex;
  min-height: 100vh;
  background: #f8f7f5;
}

.sidebar {
  width: 248px;
  flex-shrink: 0;
  padding: 30px 18px 18px;
  background: #f1efec;
  border-right: 1px solid #e8e5e1;
  display: flex;
  flex-direction: column;
}

.brand {
  display: flex;
  align-items: center;
  gap: 11px;
  padding: 0 8px;
  margin-bottom: 38px;
  font-family: 'Manrope', sans-serif;
  font-size: 19px;
  font-weight: 800;
  letter-spacing: -0.8px;
}

.brand-icon {
  width: 35px;
  height: 35px;
  display: grid;
  place-items: center;
  border-radius: 12px;
  background: #554a70;
  color: white;
  font-size: 20px;
  letter-spacing: -1px;
}

.new-note-button {
  display: flex;
  align-items: center;
  gap: 10px;
  width: 100%;
  padding: 13px 12px;
  border: 1px solid #e7e2ed;
  border-radius: 11px;
  background: #fff;
  color: #36303f;
  font-weight: 600;
  box-shadow: 0 2px 5px #27212b08;
}

.new-note-button > span {
  font-size: 21px;
  color: #76658e;
}

kbd {
  padding: 3px 6px;
  border: 1px solid #e7e3e9;
  border-radius: 5px;
  background: #faf9fb;
  color: #827b89;
  font-size: 10px;
}

.new-note-button kbd {
  margin-left: auto;
}

.nav-label {
  margin: 35px 10px 12px;
  color: #96909a;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 1.6px;
}

.nav-item {
  display: flex;
  align-items: center;
  gap: 12px;
  width: 100%;
  padding: 12px 13px;
  border: 0;
  border-radius: 9px;
  background: transparent;
  color: #77717e;
  text-align: left;
  font-size: 13px;
  margin-bottom: 4px;
}

.nav-item > span:first-child {
  width: 17px;
  font-size: 17px;
  text-align: center;
}

.nav-item.active {
  background: #e5e0ee;
  color: #514568;
  font-weight: 600;
}

.nav-count {
  margin-left: auto;
  font-size: 11px;
  opacity: 0.7;
}

.sidebar-bottom {
  margin-top: auto;
}

.sync-indicator {
  display: flex;
  gap: 10px;
  align-items: center;
  padding: 15px 10px;
  border-top: 1px solid #e2dfdb;
}

.status-dot {
  display: inline-block;
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #7da58a;
  flex-shrink: 0;
}

.sync-indicator strong, .sync-indicator small {
  display: block;
}

.sync-indicator strong {
  font-size: 12px;
  font-weight: 600;
}

.sync-indicator small {
  margin-top: 4px;
  color: #8a848d;
  font-size: 10px;
}

.version-label {
  padding: 10px;
  color: #aaa4ac;
  font-size: 9px;
  letter-spacing: 1.1px;
}

.main-content {
  flex: 1;
  min-width: 0;
}

.topbar {
  height: 75px;
  padding: 0 5%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid #eeece9;
}

.breadcrumb {
  display: flex;
  gap: 12px;
  align-items: center;
  color: #9a949d;
  font-size: 12px;
}

.breadcrumb .slash {
  color: #d1cbd3;
}

.breadcrumb strong {
  color: #514b57;
  font-weight: 600;
}

.topbar-right {
  display: flex;
  align-items: center;
  gap: 17px;
}

.local-badge {
  display: flex;
  align-items: center;
  gap: 7px;
  padding: 7px 10px;
  border: 1px solid #e8e5e1;
  border-radius: 20px;
  background: white;
  color: #77717b;
  font-size: 10px;
}

.avatar {
  width: 30px;
  height: 30px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: #e5dfed;
  color: #594b70;
  font-size: 12px;
  font-weight: 700;
}

.workspace {
  width: 100%;
  max-width: 1440px;
  margin: auto;
  padding: 56px 5% 24px;
}

.welcome-row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20px;
}

.eyebrow {
  color: #95899f;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 2px;
}

h1 {
  margin: 14px 0 9px;
  font-family: 'Manrope', sans-serif;
  font-size: clamp(30px, 3.5vw, 43px);
  font-weight: 600;
  letter-spacing: -2px;
  line-height: 1.15;
}

.subtitle {
  margin: 0;
  color: #8b858f;
  font-size: 13px;
  line-height: 1.7;
}

.create-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 9px;
  flex-shrink: 0;
  padding: 12px 16px;
  border: 0;
  border-radius: 10px;
  background: #554a70;
  color: #fff;
  font-size: 12px;
  font-weight: 600;
  box-shadow: 0 4px 10px #554a701c;
  transition: background 160ms ease, transform 160ms ease;
}

.create-button:hover {
  background: #433858;
  transform: translateY(-1px);
}

.create-button > span {
  font-size: 18px;
}

.toolbar {
  display: flex;
  align-items: center;
  gap: 15px;
  margin: 36px 0 22px;
}

.search-box {
  display: flex;
  align-items: center;
  gap: 11px;
  flex: 1;
  max-width: 510px;
  padding: 0 13px;
  height: 43px;
  border: 1px solid #e9e5e2;
  border-radius: 10px;
  background: #fff;
  transition: border-color 160ms ease, box-shadow 160ms ease;
}

.search-box:focus-within {
  border-color: #b9accd;
  box-shadow: 0 0 0 3px #8b78ad12;
}

.search-icon {
  color: #948b9a;
  font-size: 23px;
  transform: rotate(-20deg);
}

.search-box input {
  flex: 1;
  min-width: 0;
  border: 0;
  outline: 0;
  background: transparent;
  color: #39343e;
  font-size: 12px;
}

.search-box input:focus-visible {
  outline: none;
}

.search-box input::placeholder {
  color: #aaa4ad;
}

.note-total {
  color: #99929b;
  font-size: 11px;
}

.notes-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  align-items: start;
  gap: 17px;
}

.note-card {
  display: flex;
  flex-direction: column;
  min-width: 0;
  min-height: 215px;
  padding: 18px;
  border: 1px solid #eae6e1;
  border-radius: 13px;
  box-shadow: 0 3px 12px #33283d05;
  transition: transform 180ms ease, box-shadow 180ms ease;
}

.note-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 8px 22px #33283d0d;
}

.note-card.lavender { background: #eeebf5; border-color: #e5dfef; }
.note-card.blue { background: #e9eef6; border-color: #dfe6f0; }
.note-card.sage { background: #eaf0e6; border-color: #dfe7da; }
.note-card.peach { background: #f5ebe1; border-color: #eee2d6; }
.note-card.cream { background: #fffefa; border-color: #ece8e0; }
.note-card.pink { background: #f5e9ed; border-color: #eddee4; }

.card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 13px;
}

.note-tag {
  color: #807887;
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.3px;
}

.pin-button, .delete-button {
  border: 0;
  background: transparent;
  color: #9a929e;
}

.pin-button {
  padding: 0 2px;
  font-size: 17px;
}

.pin-button.is-pinned {
  color: #65537e;
}

.card-title {
  width: 100%;
  padding: 0;
  border: 0;
  outline: none;
  background: transparent;
  color: #38313f;
  font-family: 'Manrope', sans-serif;
  font-size: 14px;
  font-weight: 700;
  letter-spacing: -0.3px;
}

.card-title:focus {
  box-shadow: 0 1px #b6a6c9;
}

.card-body {
  display: block;
  width: 100%;
  min-height: 85px;
  margin-top: 10px;
  padding: 0;
  resize: vertical;
  border: 0;
  outline: none;
  background: transparent;
  color: #716a76;
  font-size: 12px;
  line-height: 1.8;
}

.card-body::placeholder {
  color: #aaa2ae;
}

.card-body:focus {
  box-shadow: 0 1px #b6a6c9;
}

.card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12px;
  padding-top: 10px;
  border-top: 1px solid #6e627215;
}

.card-footer select {
  max-width: 110px;
  padding: 4px 0;
  border: 0;
  outline: 0;
  background: transparent;
  color: #847b88;
  font-size: 10px;
  cursor: pointer;
}

.delete-button {
  padding: 4px;
  font-size: 10px;
  opacity: 0;
  transition: opacity 150ms ease;
}

.note-card:hover .delete-button,
.delete-button:focus-visible {
  opacity: 1;
}

.empty-state {
  padding: 65px 20px;
  text-align: center;
}

.empty-icon {
  color: #b3a6c4;
  font-size: 42px;
}

.empty-state h2 {
  margin: 15px 0 8px;
  font-family: 'Manrope', sans-serif;
  font-size: 20px;
}

.empty-state p {
  margin-bottom: 20px;
  color: #8b858f;
  font-size: 12px;
}

.workspace-footer {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  margin-top: 45px;
  padding: 18px 0;
  border-top: 1px solid #eeebe7;
  color: #aaa3ad;
  font-size: 10px;
}

@media (max-width: 1100px) {
  .notes-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 700px) {
  .sidebar {
    width: 70px;
    padding: 20px 8px;
  }

  .brand {
    justify-content: center;
    padding: 0;
    margin-bottom: 25px;
  }

  .brand > span,
  .nav-label,
  .nav-item:not(.active),
  .nav-item.active {
    font-size: 0;
  }

  .brand > span,
  .new-note-button:not(:focus),
  .nav-item .nav-count,
  .sidebar-bottom {
    display: none;
  }

  .new-note-button {
    justify-content: center;
    padding: 10px 0;
    font-size: 0;
  }

  .new-note-button > span {
    font-size: 23px;
  }

  .nav-item {
    justify-content: center;
    padding: 12px 0;
    font-size: 0;
  }

  .nav-item > span:first-child {
    font-size: 20px;
  }

  .workspace {
    padding: 35px 18px 20px;
  }

  .topbar {
    padding: 0 18px;
  }

  .local-badge {
    font-size: 0;
  }

  .local-badge .status-dot {
    width: 8px;
    height: 8px;
  }

  .welcome-row {
    align-items: flex-start;
    flex-direction: column;
  }

  .notes-grid {
    grid-template-columns: 1fr;
  }

  .workspace-footer {
    flex-direction: column;
  }
}/* BetterNote — full Markdown editor */

.open-editor-button {
  padding: 5px 8px;
  border: 1px solid #ded7e8;
  border-radius: 6px;
  background: #ffffffa8;
  color: #5b4b72;
  font-size: 10px;
  font-weight: 600;
  transition: background 150ms ease;
}

.open-editor-button:hover {
  background: #fff;
}

.editor-overlay {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: flex;
  justify-content: center;
  align-items: stretch;
  padding: 22px;
  background: rgba(38, 32, 45, 0.42);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
}

.editor-window {
  display: flex;
  flex-direction: column;
  width: 100%;
  max-width: 1100px;
  min-height: 0;
  overflow: hidden;
  border: 1px solid #e9e4ed;
  border-radius: 17px;
  background: #fffefa;
  box-shadow: 0 25px 90px #20172d30;
  animation: editor-enter 180ms ease-out;
}

@keyframes editor-enter {
  from {
    opacity: 0;
    transform: translateY(8px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.editor-header {
  display: flex;
  align-items: center;
  gap: 16px;
  min-height: 60px;
  padding: 0 24px;
  border-bottom: 1px solid #eee9e5;
  background: #fffefa;
}

.editor-back-button,
.editor-close-button {
  border: 0;
  background: transparent;
  color: #716879;
  cursor: pointer;
}

.editor-back-button {
  padding: 8px 0;
  font-size: 12px;
}

.editor-back-button:hover {
  color: #554a70;
}

.editor-save-status {
  margin-left: auto;
  color: #89818d;
  font-size: 11px;
}

.editor-close-button {
  width: 30px;
  height: 30px;
  border-radius: 8px;
  font-size: 25px;
  line-height: 1;
}

.editor-close-button:hover {
  background: #f0edf2;
}

.editor-document {
  display: flex;
  flex: 1;
  flex-direction: column;
  width: 100%;
  max-width: 790px;
  min-height: 0;
  margin: 0 auto;
  padding: 55px 48px 25px;
}

.editor-eyebrow {
  margin-bottom: 22px;
  color: #95889f;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 1.8px;
}

.editor-title {
  width: 100%;
  padding: 0;
  border: 0;
  outline: none;
  background: transparent;
  color: #302a37;
  font-family: 'Manrope', sans-serif;
  font-size: clamp(28px, 4vw, 42px);
  font-weight: 600;
  letter-spacing: -1.7px;
  line-height: 1.3;
}

.editor-title::placeholder {
  color: #c3bdc6;
}

.editor-title:focus-visible {
  outline: none;
}

.editor-hint {
  margin-top: 14px;
  padding-bottom: 25px;
  border-bottom: 1px solid #eee9e5;
  color: #aaa1ad;
  font-size: 11px;
}

.markdown-editor {
  flex: 1;
  width: 100%;
  min-height: 300px;
  margin-top: 26px;
  padding: 0;
  resize: none;
  border: 0;
  outline: none;
  background: transparent;
  color: #49434d;
  font-family: 'SFMono-Regular', Consolas, 'Liberation Mono', monospace;
  font-size: 13px;
  line-height: 1.95;
  tab-size: 2;
}

.markdown-editor::placeholder {
  color: #b4acb8;
}

.markdown-editor:focus-visible {
  outline: none;
}

.editor-footer {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  margin-top: 18px;
  padding-top: 14px;
  border-top: 1px solid #eee9e5;
  color: #a39ba6;
  font-size: 10px;
}

@media (max-width: 600px) {
  .editor-overlay {
    padding: 7px;
  }

  .editor-window {
    border-radius: 12px;
  }

  .editor-header {
    padding: 0 14px;
  }

  .editor-document {
    padding: 35px 22px 20px;
  }

  .editor-title {
    font-size: 29px;
  }

  .markdown-editor {
    font-size: 12px;
  }
}